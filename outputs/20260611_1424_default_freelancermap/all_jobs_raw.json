    "title": "Enterprise Architect (m/w/d) CCIE / Netzwerk (MPLS, SD-WAN)",
    "company": "1st solution consulting gmbh",
    "location": "remote Deutschland",
    "link": "https://www.freelancermap.de/projekt/enterprise-architect-m-w-d-ccie-netzwerk-mpls-sd-wan",
    "job_id": "enterprise-architect-m-w-d-ccie-netzwerk-mpls-sd-wan",
