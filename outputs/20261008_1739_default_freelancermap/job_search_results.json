  {
    "title": "Projektmanager Qualitätssicherung (m/w/d) Remote und Nürnberg / ZWSC238380",
    "company": "GECO Deutschland GmbH",
    "location": "Köln  Deutschland",
    "link": "https://www.freelancermap.de/projekt/projektmanager-qualitaetssicherung-m-w-d-remote-und-nuernberg-zwsc238380",
    "job_id": "projektmanager-qualitaetssicherung-m-w-d-remote-und-nuernberg-zwsc238380",
    "provider": "freelancermap",
    "posted_at_relative": "17:44",
