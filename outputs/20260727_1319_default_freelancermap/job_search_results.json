    "title": "Glasfaser- und Netzwerkplaner (m/w/d) // Freelancer oder Festanstellung",
    "company": "Gimbel Consulting GmbH",
    "location": "Düsseldorf Deutschland",
    "link": "https://www.freelancermap.de/projekt/glasfaser-und-netzwerkplaner-m-w-d-freelancer-oder-festanstellung",
    "job_id": "glasfaser-und-netzwerkplaner-m-w-d-freelancer-oder-festanstellung",
