    "title": "Externer Senior DevOps Engineer / Consultant – DevOps Enablement",
    "company": "WeMatch Consulting GmbH",
    "location": "Berlin Deutschland",
    "link": "https://www.freelancermap.de/projekt/externer-senior-devops-engineer-consultant-devops-enablement",
