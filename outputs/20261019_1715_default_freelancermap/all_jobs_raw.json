    "title": "Electrical Integration Technician – HIL Test Benches (m/w/d) | Raum Europa | Remote/Onsite",
    "company": "Halian GmbH",
    "location": "München Deutschland",
    "link": "https://www.freelancermap.de/projekt/electrical-integration-technician-hil-test-benches-m-w-d-raum-europa-remote-onsite",
    "job_id": "electrical-integration-technician-hil-test-benches-m-w-d-raum-europa-remote-onsite",
