  {
    "title": "Projekt Manager Rollout Digitaler Arbeitsplatz (m/w/d) – AFRA-11031",
    "company": "Randstad Digital Germany AG",
    "location": "Frankfurt Deutschland",
    "link": "https://www.freelancermap.de/projekt/projekt-manager-rollout-digitaler-arbeitsplatz-m-w-d-afra-11031",
    "job_id": "projekt-manager-rollout-digitaler-arbeitsplatz-m-w-d-afra-11031",
    "provider": "freelancermap",
    "posted_at_relative": "14:40",
